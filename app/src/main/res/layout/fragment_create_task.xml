<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/custombg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp"
    >

    <!-- Task Title Input -->
    <EditText
        android:id="@+id/taskTitleInput"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:background="@drawable/input_bd_dark"
        android:hint="@string/task"
        android:textColor="@color/white"
        android:textColorHint="#80FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/task"
        android:drawablePadding="8dp"
        android:inputType="text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description Input -->
    <EditText
        android:id="@+id/taskDescriptionInput"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/input_bd_dark"
        android:foregroundGravity=""
        android:hint="@string/description"
        android:textColor="@color/white"
        android:textColorHint="#80FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:drawableStart="@drawable/description"
        android:drawablePadding="8dp"
        android:inputType="textMultiLine"
        android:gravity="start|top"
        app:layout_constraintTop_toBottomOf="@+id/taskTitleInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Date Input -->
    <EditText
        android:id="@+id/taskDateInput"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/input_bd_dark"
        android:hint="@string/date"
        android:textColor="@color/white"
        android:textColorHint="#80FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/date"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@+id/taskDescriptionInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/taskTimeInput" />

    <!-- Time Input -->
    <EditText
        android:id="@+id/taskTimeInput"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/input_bd_dark"
        android:hint="Time"
        android:textColor="@color/white"
        android:textColorHint="#80FFFFFF"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:drawableStart="@drawable/clock"
        android:drawablePadding="8dp"
        android:focusable="false"
        android:clickable="true"
        app:layout_constraintTop_toBottomOf="@+id/taskDescriptionInput"
        app:layout_constraintStart_toEndOf="@+id/taskDateInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/cancelBtn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="cancel"
        android:textColor="@color/blue_900"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/btn_cancel_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@+id/taskDateInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/createBtn" />

    <!-- Create Button -->
    <TextView
        android:id="@+id/createBtn"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"
        android:text="create"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="@drawable/btn_create_bg"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@+id/taskDateInput"
        app:layout_constraintStart_toEndOf="@+id/cancelBtn"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>